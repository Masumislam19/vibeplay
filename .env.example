# VibePlay environment configuration — placeholders only. Never commit real secrets.
#
# Copy this file to `.env.local` or `.env` for local development, or configure these keys
# in your hosting dashboard (Render, Railway, Vercel, Netlify, or VPS).

# MongoDB Atlas M0 Free (primary application database)
MONGODB_URI=
MONGODB_DB_NAME=vibeplay

# Single-owner Admin setup key (used once at /admin/setup for markket287@gmail.com)
# Generate with: openssl rand -hex 24
ADMIN_SETUP_KEY=

# Supabase Storage (ONLY media storage provider for videos and thumbnails)
NEXT_PUBLIC_SUPABASE_URL=https://qgmeydlcvyggavtftmyz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=vibeplay-media

# Public site URL (used for canonical/absolute SEO metadata, e.g. https://your-site.com)
SITE_URL=

# Optional conservative storage stop threshold in MB (default: 950, max: 1000 on Free 1 GB plan)
SUPABASE_MAX_STORAGE_MB=950
